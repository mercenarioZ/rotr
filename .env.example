# Copy this to `.env` and adjust.
#
# Expo inlines EXPO_PUBLIC_* variables into the bundle at build time, so they
# are NOT secret. Never put credentials or tokens in one.

# Origin of the Routine Tracker API.
#
# Origin only — no trailing slash and no `/v1/api`; the client adds the version
# prefix so it lives in exactly one place.
#
# When unset, the app falls back to:
#   Android emulator -> http://10.0.2.2:8000
#   iOS simulator    -> http://localhost:8000
#
# A physical device can reach neither of those, so give it your machine's LAN
# address (the same network as the phone):
EXPO_PUBLIC_API_URL=http://192.168.1.11:8000
